# Server and Port configuration
PORT=3000
BACKEND_PORT=3000

# Security & Tokens
JWT_SECRET=your_jwt_secret_here

# Database - MongoDB Atlas Connection String (Optional - falls back to In-Memory mode if unset)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Predefined Administrator Credentials & Institution Setup
ADMIN_IDENTIFIER=vcetadmin
ADMIN_PASSWORD=your_secure_admin_password
PRIMARY_INSTITUTION_NAME=vidyavardhini college of engineering and technology

# Gemini AI Service (powers Study AI tutor for teachers & students)
GEMINI_API_KEY=your_gemini_api_key_here
CAMPUS_CODE=
SEED_TEST_FIXTURES=false
