# Server and Port configuration
PORT=3000
BACKEND_PORT=3000

# Security & Tokens
JWT_SECRET=your_jwt_secret_key_here

# Database - MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_crm?retryWrites=true&w=majority
MONGODB_URI=

# Predefined Administrator Credentials & Institution Setup
# Used to seed/configure the primary institution administrator account securely in production.
ADMIN_IDENTIFIER=admin@smartcrm.local
ADMIN_PASSWORD=your_secure_admin_password
PRIMARY_INSTITUTION_NAME=

# Gemini AI Service (Optional - powers Study AI tutor for teachers & students)
GEMINI_API_KEY=
CAMPUS_CODE=
SEED_TEST_FIXTURES=false